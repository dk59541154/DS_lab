#include <stdio.h>

int main() {
    int arr[100];
    int size, temp, min_index;

    // 1. Get array size and inputs from the user
    printf("How many numbers do you want to sort? ");
    scanf("%d", &size);

    printf("Enter %d numbers:\n", size);
    for (int i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }

    // 2. SELECTION SORT LOGIC
    for (int i = 0; i < size - 1; i++) {
        min_index = i;
        
        
        for (int j = i + 1; j < size; j++) {
            if (arr[j] < arr[min_index]) {
                min_index = j; // Update index of the smallest number
            }
        }
        

        temp = arr[min_index];
        arr[min_index] = arr[i];
        arr[i] = temp;
    }

    // 3. Print the sorted results
    printf("\nSorted Array:\n");
    for (int i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
