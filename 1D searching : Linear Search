// Linear Search

#include <stdio.h>

int main() {
    int arr[] = {40, 10, 50, 20, 30};
    int target = 20; // Number to look for
    int size = 5;

    // Check each item one by one
    for (int i = 0; i < size; i++) {
        if (arr[i] == target) {
            printf("Found at index %d\n", i);
            return 0;
        }
    }

    printf("Not found\n");
    return 0;
}
