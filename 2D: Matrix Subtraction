#include <stdio.h>

int main() {
    int rows = 3, cols = 3; 
    int A[3][3], B[3][3];
    
    int diff[3][3]; // Stores subtraction

    // 1. Take input for Matrix A
    printf("Enter 9 numbers for Matrix A:\n");
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    // 2. Take input for Matrix B
    printf("\nEnter 9 numbers for Matrix B:\n");
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            diff[i][j] = A[i][j] - B[i][j]; // Subtraction 
        }
    }

   

    //  Print Subtraction Result
    printf("\nSubtraction Result (A - B):\n");
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            printf("%d ", diff[i][j]);
        }
        printf("\n");
    }

    return 0;
}
